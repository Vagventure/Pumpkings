  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 113433166}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f822be2a760648e98c5ed32facb8c0d1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LevelController
  goalBoxText: {fileID: 0}
  startingMusicState: {fileID: 11400000, guid: d7a5c000b92182b4cb5836d3f35319bf, type: 2}
  awarenessEvents:
  - requiredValue: 20
    goal: Keep Spreading awareness.
    eventDefinition: {fileID: 11400000, guid: 0e8803dc91e34c27be5f827efb23bcfb, type: 2}
    completionEffect: 0
    rewardItems: []
    choicesSide: 0
    dialogueChoices:
    - rewardPath: 1
      buttonText: Kids could draw posters in their art classess.
      playerLine: 'Oh that is amazing! In-house made posters will significantly reduce
        costs of posters! '
      playerVoiceClip: {fileID: 0}
    - rewardPath: 3
      buttonText: We can organize a weekly clean-up activity around the beach.
      playerLine: I think weekly clen-up could allow me to focus on different activities
        while this awesome place is kept in tact.
      playerVoiceClip: {fileID: 0}
    - rewardPath: 2
      buttonText: Our biology teacher is willing to give lecutre on local environment
        once a week.
      playerLine: Classes would be amazing, teaching younger generations awareness
        of our local problem!
      playerVoiceClip: {fileID: 0}
    musicStateAfterCompletion: {fileID: 0}
  - requiredValue: 50
    goal: Keep Spreading awareness.
    eventDefinition: {fileID: 11400000, guid: 91af66a9c689cf849a4ef71b1e666d60, type: 2}
    completionEffect: 0
    rewardItems:
    - {fileID: 11400000, guid: f00b7c1fec894cdb90f2595e2375fd82, type: 2}
    - {fileID: 11400000, guid: 1fcf1f6a906743bb9da7cbb6af4648c2, type: 2}
    choicesSide: 0
    dialogueChoices:
    - rewardPath: 1
      buttonText: Take the poster campaign beyond the local community.
      playerLine: Take the poster campaign beyond the immediate community and increase
        the reach of the message.
      playerVoiceClip: {fileID: 0}
    - rewardPath: 2
      buttonText: 'Work with more local schools to bring plastic pollution education
        into additional classrooms. '
      playerLine: Bring plastic pollution education into local classrooms and teach
        students how their everyday choices can reduce plastic waste.
      playerVoiceClip: {fileID: 0}
    - rewardPath: 3
      buttonText: Create a regular cleanup schedule with volunteers along the shoreline.
      playerLine: Place awareness posters throughout more of the community and reach
        people beyond the beach.
      playerVoiceClip: {fileID: 0}
    musicStateAfterCompletion: {fileID: 0}
  - requiredValue: 120
    goal: There will be no more reawrds sorry.
    eventDefinition: {fileID: 11400000, guid: b7c33dc6e6e4c3e46b943da9804ef79a, type: 2}
    completionEffect: 2
    rewardItems: []
    choicesSide: 1
    dialogueChoices:
    - rewardPath: 0
      buttonText: FOLLOW THE POLLUTION UPSTREAM
      playerLine: Maybe cleaning up where it ends isn't enough. I need to find out
        where it's coming from.
      playerVoiceClip: {fileID: 0}
    musicStateAfterCompletion: {fileID: 0}
  goldGatheredEvents:
  - requiredValue: 5
    goal: Purchase posters to spread awareness
    eventDefinition: {fileID: 11400000, guid: 39593ccde8d7a734cabbc83aa9d9f2a7, type: 2}
    completionEffect: 0
    rewardItems:
