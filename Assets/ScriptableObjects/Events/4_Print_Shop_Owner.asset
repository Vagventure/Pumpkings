  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18eb5d745b1645f997d01db0ed6f4f60, type: 3}
  m_Name: 4_Print_Shop_Owner
  m_EditorClassIdentifier: Assembly-CSharp::EventDefinition
  dialogueLines:
  - speakerSide: 0
    speaker: {fileID: 11400000, guid: b08f111c9ea1baf4bbb0016ae33f621c, type: 2}
    expression: 1
    text: 'I''ve seen your posters around the beach. People are finally paying attention
      to what''s washing ashore. '
    voiceClip: {fileID: 0}
  - speakerSide: 1
    speaker: {fileID: 11400000, guid: e6a39e25f4dd43348f54a26e95f17904, type: 2}
    expression: 1
    text: I think they all see just the end result but are ill-informed on how it
      gets to that point.
    voiceClip: {fileID: 0}
  - speakerSide: 0
    speaker: {fileID: 11400000, guid: b08f111c9ea1baf4bbb0016ae33f621c, type: 2}
    expression: 1
    text: ' We should focus the campaign on the whole route, where it starts from
      streets and dumpsites to how it flows to the river and then to the ocean.

'
    voiceClip: {fileID: 0}
  - speakerSide: 1
    speaker: {fileID: 11400000, guid: e6a39e25f4dd43348f54a26e95f17904, type: 2}
    expression: 1
    text: We can place them throughout the neighborhoods upstream.
    voiceClip: {fileID: 0}
  revealTextDuringEntrance: 1
  playerChoiceSpeaker: {fileID: 11400000, guid: e6a39e25f4dd43348f54a26e95f17904, type: 2}
  playerChoiceSpeakerSide: 1
  playerChoiceExpression: 0
  rewardTitle: Select local company to help
