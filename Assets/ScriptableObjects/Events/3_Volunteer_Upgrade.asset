  dialogueLines:
  - speakerSide: 0
    speaker: {fileID: 11400000, guid: 0f0dad7549b9428da723e8ffdf60aa76, type: 2}
    expression: 1
    text: 'Hi! Im local Volunteer Organizer, Running a group of Volunteers. One of
      the kids from the school asked me if we could help as an volunteers. '
    voiceClip: {fileID: 0}
  - speakerSide: 1
    speaker: {fileID: 11400000, guid: e6a39e25f4dd43348f54a26e95f17904, type: 2}
    expression: 1
    text: Oh, I didn't expect this to grow this far! Of course all help is appreciated,
      what is on your mind ?
    voiceClip: {fileID: 0}
  - speakerSide: 0
    speaker: {fileID: 11400000, guid: 0f0dad7549b9428da723e8ffdf60aa76, type: 2}
    expression: 1
    text: 'Here are some options:'
    voiceClip: {fileID: 0}
