  dialogueLines:
  - speakerSide: 1
    speaker: {fileID: 11400000, guid: e6a39e25f4dd43348f54a26e95f17904, type: 2}
    expression: 1
    text: 'The water is rising.

'
    voiceClip: {fileID: 0}
  - speakerSide: 1
    speaker: {fileID: 11400000, guid: e6a39e25f4dd43348f54a26e95f17904, type: 2}
    expression: 1
    text: Every piece of waste left near the river is being swept into the current.
    voiceClip: {fileID: 0}
  - speakerSide: 1
    speaker: {fileID: 11400000, guid: e6a39e25f4dd43348f54a26e95f17904, type: 2}
    expression: 1
    text: 'If we wait until the storm passes, most of it will already be on its way
      to the ocean.


'
    voiceClip: {fileID: 0}
