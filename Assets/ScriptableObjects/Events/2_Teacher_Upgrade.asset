MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18eb5d745b1645f997d01db0ed6f4f60, type: 3}
  m_Name: 2_Teacher_Upgrade
  m_EditorClassIdentifier: Assembly-CSharp::EventDefinition
  dialogueLines:
  - speakerSide: 0
    speaker: {fileID: 11400000, guid: 21fbf5226ebd72e41bda15f512c52a55, type: 2}
    expression: 1
    text: Your posters are working. My students have been talking about plastic on
      the beach and asking what they can do about it.
    voiceClip: {fileID: 0}
  - speakerSide: 1
    speaker: {fileID: 11400000, guid: e6a39e25f4dd43348f54a26e95f17904, type: 2}
    expression: 1
    text: People are finally paying attention. I just don't know where we should
      focus next.
    voiceClip: {fileID: 0}
  - speakerSide: 0
    speaker: {fileID: 11400000, guid: 21fbf5226ebd72e41bda15f512c52a55, type: 2}
    expression: 1
    text: Then let's give that attention somewhere to go. We can teach people, get
      them directly involved, or make sure the message reaches even farther.
    voiceClip: {fileID: 0}
  revealTextDuringEntrance: 1
  playerChoiceSpeaker: {fileID: 11400000, guid: e6a39e25f4dd43348f54a26e95f17904, type: 2}
  playerChoiceSpeakerSide: 1
  playerChoiceExpression: 0
  rewardTitle: How would you like us to help?
